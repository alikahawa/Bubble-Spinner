<?xml version="1.0" encoding="UTF-8"?>

<!--
  Modern Game Screen for Bubble-Spinner Game
  
  This FXML file defines the modernized game interface with improved
  layout, better visual hierarchy, and professional game controls.
  
  Author: Ali Kahawati (Modernization Update)
  Date: August 2025
  Version: 2.0
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="gui.GameController"
            styleClass="game-screen">
    
    <!-- Top Status Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="game-controls">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20" />
            </padding>
            
            <!-- Score Display -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="SCORE:" styleClass="caption-text">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Text fx:id="scoreText" text="0" styleClass="score-display">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Level Information -->
            <HBox alignment="CENTER" spacing="8">
                <Label text="LEVEL:" styleClass="caption-text">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="levelText" text="1" styleClass="score-display">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </HBox>
            
        </HBox>
    </top>
    
    <!-- Main Game Area -->
    <center>
        <StackPane>
            
            <!-- Game Play Field Container -->
            <Pane fx:id="panee" maxHeight="720.0" maxWidth="720.0" 
                  prefHeight="720.0" prefWidth="720.0" styleClass="game-screen">
                
                <!-- Main Play Field -->
                <Pane fx:id="playField" 
                      layoutX="31.0" layoutY="6.0" 
                      maxWidth="522.0" minWidth="522.0" 
                      prefHeight="688.0" prefWidth="522.0" 
                      styleClass="game-playfield"
                      onMouseClicked="#handleMouse" 
                      onMouseMoved="#mouseArrow" />
                
            </Pane>
            
        </StackPane>
    </center>
    
    <!-- Bottom Control Panel -->
    <bottom>
        <VBox spacing="12" styleClass="game-controls">
            <padding>
                <Insets top="16" right="20" bottom="16" left="20" />
            </padding>
            
            <!-- Bubble Preview Section -->
            <HBox alignment="CENTER" spacing="16">
                
                <!-- Current Bubble Label -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="CURRENT" styleClass="caption-text">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <Pane fx:id="currentBubblePreview" 
                          styleClass="bubble-preview"
                          prefWidth="40" prefHeight="40" />
                </VBox>
                
                <!-- Next Bubble Label -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="NEXT" styleClass="caption-text">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <Pane fx:id="nextBubblePreview" 
                          styleClass="bubble-preview"
                          prefWidth="40" prefHeight="40" />
                </VBox>
                
            </HBox>
            
            <!-- Game Control Buttons -->
            <HBox alignment="CENTER" spacing="12">
                
                <!-- Play Button -->
                <Button fx:id="playButton" 
                        text="▶ PLAY" 
                        styleClass="btn-primary"
                        onAction="#playGame" 
                        prefWidth="80" 
                        prefHeight="35">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                
                <!-- Pause Button -->
                <Button fx:id="pauseButton" 
                        text="⏸ PAUSE" 
                        styleClass="btn-secondary"
                        onAction="#pauseGame" 
                        prefWidth="80" 
                        prefHeight="35">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                
                <!-- Menu Button -->
                <Button fx:id="menuButton" 
                        text="📋 MENU" 
                        styleClass="btn-outline"
                        onAction="#handleMenuButtonAction" 
                        prefWidth="80" 
                        prefHeight="35">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                
            </HBox>
            
            <!-- Game Instructions -->
            <Label text="🎯 Aim with mouse • Click to shoot • Match 3+ bubbles to clear them" 
                   styleClass="caption-text" 
                   maxWidth="600" 
                   wrapText="true"
                   textAlignment="CENTER">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            
        </VBox>
    </bottom>
    
</BorderPane>
